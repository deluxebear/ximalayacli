{
  "name": "ximalaya-studio-cli",
  "version": "0.4.0",
  "description": "喜马拉雅创作中心命令行工具",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deluxebear/ximalayacli.git"
  },
  "type": "module",
  "bin": {
    "xmly": "bin/xmly.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "docs",
    "skills",
    "install.sh",
    "examples"
  ],
  "scripts": {
    "check": "find bin lib -name '*.mjs' -exec node --check {} +",
    "test": "node --test",
    "prepack": "npm run check",
    "pack:dry": "npm pack --dry-run"
  }
}
